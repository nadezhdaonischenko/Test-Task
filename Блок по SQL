/* ============================================================================
   ЗАДАЧА 3. Нарастающий итог по продажам
   ============================================================================
   Логика решения: 
   Базовое агрегирование и расчет аналитического окна разделены на два шага, 
   чтобы избежать конфликта СУБД при одновременном схлопывании строк и вычислении окна. 
   В подзапросе table_sum продажи суммируются по месяцам и категориям. В основном 
   запросе рассчитывается нарастающее SUM(amount) OVER(...) с рамкой строк 
   rows between unbounded preceding and current row. Конструкция 
   PARTITION BY to_char(month_num, 'YYYY'), cat_name изолирует расчеты, благодаря 
   чему накопление продаж идет независимо для каждой категории и автоматически 
   обнуляется при переходе на следующий календарный год. 
   Результат разделен на столбцы года и месяца для логического разделения годовых данных. 
   Если потребуется детализация или агрегация данных до уровня месяца, скрипт необходимо скорректировать (2-ой вариант ниже).
   ============================================================================ */

with table_sum as (
	select date_trunc('month', date_check)::date as month_num,
	   	   cat_name,
	   	   sum(quantity) as amount
	from test_orders_dataset tod
	join test_tovari_dataset ttd on ttd.tov_id=tod.tov_id 
	join test_categories_dataset tcd on ttd.cat_id=tcd.cat_id
	group by date_trunc('month', date_check)::date, cat_name
)

select to_char(month_num, 'YYYY') AS "Год",
	   to_char(month_num, 'TMMonth') AS "Месяц",
	   cat_name as "Категория",
	   amount as "Кол-во проданного товара",
	   sum(amount) over(
                    partition by to_char(month_num, 'YYYY'), cat_name 
                    order by month_num 
                    rows between unbounded preceding and current row) as "Нарастающий итог"
from table_sum
order by month_num, cat_name;

