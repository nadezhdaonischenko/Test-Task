/* ============================================================================
   ЗАДАЧА 2. Поиск регулярных продаж товара в течение недели
   ============================================================================
   Логика решения: 
   Справочник товаров объединяется с таблицей заказов по идентификатору tov_id. 
   Период ограничен в блоке WHERE жесткими рамками с 1 по 7 апреля 2024 года. 
   Ключевая аналитическая логика заложена в блоке HAVING: условие 
   COUNT(DISTINCT date_check) = 7 гарантирует, что в итоговый отчет попадут только 
   те товары, у которых зафиксированы продажи в каждый из 7 дней этой недели без 
   исключений. 
   ============================================================================ */

select name as "Товар", sum(quantity*price) as "Объем продаж"
from test_tovari_dataset ttd 
join test_orders_dataset tod on ttd.tov_id=tod.tov_id
where date_check between '2024-04-01' and '2024-04-07'
group by name
having count(distinct date_check)=7;

