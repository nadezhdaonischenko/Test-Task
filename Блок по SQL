/* ============================================================================
   ЗАДАЧА 4. Средний чек и маржинальность (Метрики за 2023 год)
   ============================================================================
   Логика решения: 
   В данной задаче рассчитываются метрики в разрезе сегментов 
   и каналов продаж за 2022 год. Чтобы оффлайн-заказы не пропали из отчета 
   (для них поле cust_id в заказах пустое), используется LEFT JOIN к таблице клиентов. 
   Функция COALESCE перехватывает значения NULL и подставляет вместо них статус 
   «новый участник». Логика разделения на online / offline реализована через 
   проверку наличия интернет-номера заказа (CASE WHEN ord_id IS NULL). При расчете 
   среднего чека применена формула SUM(выручки) / COUNT(DISTINCT check_id), 
   что позволяет узнать среднюю стоимость всей корзины. 
   Маржинальность рассчитана как разница между выручкой и себестоимостью продаж.
   В блоке GROUP BY использованы порядковые номера столбцов из SELECT, 
   чтобы избежать дублирования громоздких выражений.
   ============================================================================ */

select coalesce(segment, 'новый участник') as "Сегмент",
	   case 
	   	when ord_id is null then 'offline'
	   	else 'online'
	   end as "Тип заказа",
	   round(sum(quantity*price)/count(distinct check_id), 2) as "Средний чек",
	   round(sum(quantity*price) - sum(quantity*sebest), 2) as "Валовая маржа"
from test_orders_dataset tod
join test_tovari_dataset ttd on ttd.tov_id=tod.tov_id 
left join test_customers_dataset tcd on tcd.cust_id=tod.cust_id
where extract(year from date_check::date) = 2022
group by 1, 2
order by "Валовая маржа" desc;
