/* ============================================================================
   ЗАДАЧА 1. Ранжирование ТОП-5 товаров в каждой категории по месяцам
   ============================================================================
   Логика решения: 
   Для выделения лучших товаров используется двухэтапный подход через CTE. 
   Сначала на шаге table_group данные агрегируются до уровня «месяц-категория-товар» 
   для расчета чистой суммы выручки. Использование date_trunc() позволяет не терять года.
   Затем на шаге table_rnk применяется оконная функция DENSE_RANK(), 
   которая ранжирует товары по убыванию продаж отдельно внутри каждой категории каждого месяца. 
   (Если топ-5 "жестко" ограничен 5-ю позициями, функцию следует поменять на row_number()).
   Финальный фильтр отсекает топ-5 позиций. Для наглядности отчета дата разделена на два самостоятельных 
   текстовых столбца («Год» и «Месяц»), а сортировка по исходному полю month_num 
   гарантирует строго хронологический порядок вывода. 
   Добавление года обусловлено необходимостью логического разделения годовых данных. 
   Если потребуется детализация или агрегация данных до уровня месяца, скрипт необходимо скорректировать (2-ой вариант ниже).
   ============================================================================ */

with table_group as (
	select date_trunc('month', dttm)::date as month_num,
		   category,
		   name,
		   sum(summ) as amount
	from test_sales_dataset 
	group by date_trunc('month', dttm), category, name
),

table_rnk as (
	select month_num,
		   category,
		   name,
		   amount,
		   dense_rank() over(partition by month_num, category order by amount desc) as rnk
	from table_group
)

select to_char(month_num, 'YYYY') AS "Год",
	   to_char(month_num, 'TMMonth') AS "Месяц",
	   category as "Категория",
	   name as "Товар",
	   -- rnk as "ТОП-5", -- можно добавить при необходимости
	   amount as "Объем продаж"
from table_rnk
where rnk between 1 and 5
order by month_num, category, rnk;

